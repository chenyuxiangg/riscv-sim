# OS
.DS_Store
Thumbs.db

# Editors / IDE
.idea/
.vscode/
*.swp
*.swo

# Secrets & env (any language)
.env
.env.*
*.pem
*.key

# Rust / Cargo
**/target/
**/Cargo.lock.bak
target/
# Keep Cargo.lock for binaries, ignore for libraries — kernel is `cdylib`,
# server is binary, contract is library. We commit Cargo.lock at the
# workspace root (good for reproducible builds of a binary) but ignore
# any nested target/ directories.

# wasm-pack build output
front/assets/pkg/
front/assets/*.wasm
front/assets/*.js
# WASM 构建指纹表：由 tools/build-wasm.sh 在**构建成功后**重算写入，
# 记录「这份产物是由这版代码构建的」。它只对「本机这份 .wasm」有意义，
# 而 .wasm 本身不入库 ⇒ 指纹表也不入库（否则会出现「表是新的、产物是旧的」
# 的假绿：门禁跳过重建，拿旧产物去测新代码）。
tools/.wasm-code.stamp.json

# Node / JS front-end (we have no npm deps today, but if you add any)
node_modules/
front/node_modules/
front/dist/

# Test artefacts
tests/golden/_out/
tests/golden/_tmp/
*.diff

# Python helper scripts
__pycache__/
*.pyc

# Test coverage
coverage/
*.lcov
