# syntax=docker/dockerfile:1.6
#
# 单镜像：**已发布的服务端二进制 + MCP 适配层**（不重编 Rust）。
#
#   docker build -f Dockerfile.allinone -t riscv-sim:allinone .
#
# 为什么有这个文件，而 Dockerfile 还是源码构建：
#   - `Dockerfile` 是**发布口径**：从源码编，CI 用它出 v0.1.x，可复现；
#   - 这个文件是**合成口径**：直接复用已发布镜像里的 `riscv_sim_server` 与
#     `front/`，只加 python + `mcp/server.py` + 双进程入口。
#     用于「机器上没有 crates 缓存、拉不动依赖」的场合（2026-11-27 在 ali_hy
#     上实测：`cargo build --locked` 卡在依赖下载 20 分钟 0% CPU）。
#   - 两者的运行契约完全一致（同名 env、同端口、同探针），换的是二进制来源。
#
# ⚠️ 运行层用 python:3.12-slim-bookworm：mcp/server.py 是纯标准库，只需要 python3；
#    且不碰 `apt-get update`（ali_hy 上 bookworm 仓库签名公钥缺失，apt 直接失败）。
ARG SERVER_IMAGE=crpi-d990qy21vgojj2m7.cn-heyuan.personal.cr.aliyuncs.com/zyzs/riscv_sim@sha256:b44b68cc24a3eb3c7194c1da9ba99f3f65a38915709e1ff25e1f26b0169e01df

# 只当作「二进制与页面的来源」，不继承它的 ENTRYPOINT。
FROM ${SERVER_IMAGE} AS server

FROM python:3.12-slim-bookworm AS runtime

RUN useradd --system --uid 10001 --shell /usr/sbin/nologin sim \
 && mkdir -p /app /data/images \
 && chown -R sim:sim /app /data

WORKDIR /app

COPY --from=server /usr/local/bin/riscv_sim_server /usr/local/bin/riscv_sim_server
COPY --from=server /app/front /app/front

COPY docker/entrypoint.sh /usr/local/bin/sim-entrypoint
COPY docker/supervise.sh /usr/local/bin/sim-supervise
COPY docker/healthcheck.py /usr/local/bin/sim-healthcheck
COPY mcp/server.py /opt/sim-mcp/server.py

# ⚠️ server.py 显式 0444：源文件在开发机上是 600，COPY 会保留 mode ⇒ 非 root 的
#    sim 用户读不到，容器以「Permission denied」重启循环（真踩过一次）。
RUN chmod 0755 /usr/local/bin/riscv_sim_server /usr/local/bin/sim-entrypoint \
       /usr/local/bin/sim-supervise /usr/local/bin/sim-healthcheck \
 && chmod 0444 /opt/sim-mcp/server.py \
 && chown -R sim:sim /app/front /opt/sim-mcp

USER sim

ENV SIM_BIND=0.0.0.0 \
    SIM_PORT=9876 \
    SIM_FRONT_DIR=/app/front \
    SIM_IMAGE_ROOT=/data/images \
    SIM_MCP_PORT=8877 \
    SIM_MCP_HOST=0.0.0.0 \
    SIM_MCP_ALLOW_REMOTE=1

# 8877 是 MCP：容器内绑 0.0.0.0（端口映射打到容器 IP，不是回环），
# 但**宿主侧只发布 127.0.0.1** ⇒ 公网仍然没有这个端口，AI 走 SSH 隧道进来。
EXPOSE 9876 8877

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python3", "/usr/local/bin/sim-healthcheck"]

ENTRYPOINT ["/usr/local/bin/sim-supervise"]
